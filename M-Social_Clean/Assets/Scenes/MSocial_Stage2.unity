--- !u!114 &841311006
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 841311000}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 17ac9c450bc95c54083a28c8077d289f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Positive_Result: {fileID: 932143120}
  Negative_Result: {fileID: 593357349}
  answerScripts:
  - "\uC7A0\uAE50\uB9CC\uC694, \uC0C8\uCE58\uAE30 \uD558\uC2DC\uBA74 \uC548\uB418\uC8E0\"\uB77C\uACE0
    \uB9D0\uD574\uC694"
  - "\"\uC7A0\uC2DC\uB9CC\uC694, \uC904\uC758 \uB05D\uC740 \uC800\uCABD\uC774\uC5D0\uC694\"
    \uB77C\uACE0 \uB9D0\uD574\uC694. "
  - "\uADF8\uB0E5 \uC544\uBB34\uB9D0 \uD558\uC9C0 \uC54A\uACE0 \uAC00\uB9CC\uD788
    \uC788\uC5B4\uC694. "
  - "\"\uC5D0\uC774, \uB09C \uB610 \uBCC4\uAC70\uB77C\uACE0. \uC5B4\uCC28\uD53C \uADF8
    \uBC18\uC9C0 \uC624\uB798\uB418\uC11C \uB54C\uB3C4 \uD0D4\uACE0 \uBE44\uC2FC\uAC83\uB3C4
    \uC544\uB2C8\uC796\uC544. \uC5C4\uB9C8\uD55C\uD14C \uC0C8\uB85C \uC0AC\uB2EC\uB77C\uACE0
    \uD574\"\uB77C\uACE0 \uB9D0\uD5E4\uC694."
  - "\"\uC774\uB7F0, \uC815\uB9D0 \uAC71\uC815\uB418\uACA0\uB2E4. \uBC18\uC9C0 \uBE7C\uC11C
    \uC5B4\uB514\uC5D0 \uB123\uC5B4 \uB480\uC5C8\uC5B4? \uB124 \uC0DD\uAC01\uC5D4
    \uC5EC\uAE30 \uCBE4\uC5D0\uC11C \uB5A8\uC5B4\uD2B8\uB9B0\uAC83 \uAC19\uC544?\"\uB77C\uACE0
    \uB9D0\uD558\uBA70 \uAC19\uC774 \uCC3E\uC544\uC918\uC694."
  - "\"\uADF8\uB7F0\uC77C\uC774 \uC788\uC5C8\uAD6C\uB098, \uADF8\uB7FC \uBE68\uB9AC
    \uCC3E\uAE38 \uBC14\uB784\uAC8C. \uC548\uB155!\"\uC774\uB77C\uACE0 \uB9D0\uD558\uBA70
    \uAC00\uB358 \uAE38\uC744 \uAC00\uC694."
  - "'\uC55E\uC73C\uB85C \uB2E4\uC2DC\uB294 \uBC1C\uD45C \uD558\uC9C0 \uC54A\uC744
    \uAC70\uC57C'\uB77C\uACE0 \uC0DD\uAC01\uD574\uC694."
  - "'\uC0AC\uB78C\uC740 \uB204\uAD6C\uB098 \uC2E4\uC218\uD560 \uC218 \uC788\uC796\uC544'\uB77C\uACE0
    \uC0DD\uAC01\uD574\uC694."
  - "'\uC2E4\uC218\uB97C \uC904\uC774\uAE30 \uC704\uD574\uC11C \uACF5\uBD80\uB3C4
    \uD558\uACE0 \uB9D0\uD558\uB294 \uC5F0\uC2B5\uB3C4 \uC5F4\uC2EC\uD574 \uD574\uC57C\uACA0\uB2E4'\uB77C\uACE0
    \uC0DD\uAC01\uD574\uC694."
  - "\"\uC57C! \uBE68\uB9AC \uB0B4\uB824\uBD10, \uB098\uB3C4 \uD0C0\uBCF4\uAC8C\"\uB77C\uACE0
    \uB9D0\uD574\uC694."
  - "\"\uBE44\uCF1C\uBD10\" \uB77C\uACE0 \uB9D0\uD558\uBA70 \uC190\uC73C\uB85C \uBC00\uCCD0\uB0B4\uACE0
    \uC62C\uB77C\uD0C0\uC694."
  - "\"\uC640! \uC790\uC804\uAC70 \uC815\uB9D0 \uBA4B\uC9C0\uB2E4, \uB0B4\uAC00 \uC7A0\uAE50
    \uD0C0\uBD10\uB3C4 \uB420\uAE4C? \uC9C4\uC9DC \uC870\uC2EC\uD560\uAC8C~\" \uB77C\uACE0
    \uB9D0\uD574\uC694."
  - "\"\uC870\uAE08\uB9CC \uAE30\uB2E4\uB824 \uC904\uB798?. \uAE08\uBC29 \uB05D\uB098\"\uB77C\uACE0
    \uB9D0\uD574\uC694."
  - "\"\uC1A1\uC774\uC544 \uBBF8\uC548\uD574, \uAC19\uC774 \uB180\uACE0 \uC788\uC5C8\uB294\uB370
    \uB0B4\uAC00 \uAC8C\uC784\uC744 \uD588\uB124. \uC798 \uBABB\uB4E4\uC5C8\uB294\uB370
    \uB2E4\uC2DC \uC598\uAE30\uD574 \uC904\uB798?\"\uB77C\uACE0 \uB9D0\uD574\uC694."
  - "\"\uC544\uD558\uD558 \uBBF8\uC548, (\uACC4\uC18D \uAC8C\uC784 \uD558\uBA74\uC11C)
    \uAC8C\uC784 \uD558\uBA74\uC11C \uB2E4 \uB4E4\uC5C8\uC5B4. \uB09C \uADF8 \uC601\uD654
    \uBCC4\uB85C\uB358\uB370?\"\uB77C\uACE0 \uB9D0\uD574\uC694."
  - "\"\uC5D0\uC774 \uBAA8\uB974\uACA0\uB2E4\" \uB77C\uACE0 \uB9D0\uD558\uACE0 \uADF8\uB0E5
    \uAC00\uC694."
  - "\uC544\uC774\uC2A4\uD06C\uB9BC \uC9D1\uC73C\uB85C \uB3CC\uC544\uAC00\uC11C \"\uC0AC\uC7A5\uB2D8,
    \uC81C\uAC00 \uC544\uC774\uC2A4\uD06C\uB9BC\uC744 \uB5A8\uC5B4\uD2B8\uB838\uB294\uB370
    \uC5B4\uB5BB\uAC8C \uCE58\uC6CC\uC57C \uD560\uAE4C\uC694?\" \uB77C\uACE0 \uBB3C\uC5B4\uBD10\uC694."
  - "\uC544\uC774\uC2A4\uD06C\uB9BC \uC9D1\uC73C\uB85C \uB3CC\uC544\uAC00\uC11C \"\uC0AC\uC7A5\uB2D8,
    \uC81C\uAC00 \uC544\uC774\uC2A4\uD06C\uB9BC\uC744 \uB5A8\uC5B4\uD2B8\uB838\uB294\uB370
    \uC5B4\uB5BB\uAC8C \uCE58\uC6CC\uC57C \uD560\uAE4C\uC694?\" \uB77C\uACE0 \uBB3C\uC5B4\uBD10\uC694."
  - "\"\uBB50 \uC870\uAE08 \uB2A6\uACA0\uC9C0\uB9CC \uCE5C\uAD6C\uAC00 \uAE30\uB2E4\uB9AC\uACA0\uC9C0\"\uB77C\uACE0
    \uC0DD\uAC01\uD558\uACE0 \uAE30\uB2E4\uB838\uB2E4 \uB2E4\uC74C \uBC84\uC2A4\uB97C
    \uD0C0\uACE0 \uAC00\uC694. "
  - "\uCE5C\uAD6C\uC5D0\uAC8C \uC804\uD654\uD574\uC11C \"\uBBF8\uC548\uD558\uC9C0\uB9CC
    \uBC84\uC2A4\uB97C \uB193\uCCD0 20\uBD84 \uC815\uB3C4 \uB2A6\uC744\uAC83 \uAC19\uC544,
    \uC880 \uAE30\uB2E4\uB824 \uC904\uB798?\"\uB77C\uACE0 \uBD80\uD0C1\uD574\uC694."
  - "\uC57D\uC18D \uC2DC\uAC04\uC5D0 \uB2A6\uC744\uAC83\uC774 \uBD84\uBA85\uD558\uAE30\uC5D0
    \uC804\uD654\uD574\uC11C \"\uC6B0\uB9AC \uB2E4\uC74C\uC5D0 \uB9CC\uB098'\uB77C\uACE0
    \uB9D0\uD558\uACE0 \uC57D\uC18D\uC744 \uCDE8\uC18C\uD574\uC694."
  - "\uD070 \uC18C\uB9AC\uB85C \"\uC2E4\uB840\uD569\uB2C8\uB2E4 \uBE44\uCF1C\uC8FC\uC138\uC694\"\uB77C\uACE0
    \uC18C\uB9AC\uCE58\uBA70 \uAC78\uC5B4\uAC00\uC694."
  - "\uC55E\uC0AC\uB78C\uC774 \uB4E4\uC744 \uC218 \uC788\uB294 \uD06C\uAE30\uC758
    \uC18C\uB9AC\uB85C \"\uC2E4\uB840\uD569\uB2C8\uB2E4, \uC7A0\uC2DC\uB9CC\uC694\"\uB77C\uACE0
    \uB9D0\uD558\uBA70 \uBE44\uCF1C\uC8FC\uBA74 \uAC78\uC5B4\uAC00\uC694.  "
  - "\uADF8\uB0E5 \uAC00\uB9CC\uD788 \uC0AC\uB78C\uB4E4\uC774 \uBE60\uC838 \uB098\uAC08\uB54C\uAE4C\uC9C0
    \uC81C\uC790\uB9AC\uC5D0\uC11C \uAE30\uB2E4\uB824\uC694."
  - "\"\uB098\uB294 \uC774 \uC120\uBB3C\uC774 \uB9C8\uC74C\uC5D0 \uB4E4\uC9C0 \uC54A\uC544\"\uB77C\uACE0
    \uC194\uC9C1\uD558\uAC8C \uB9D0\uD574\uC694"
  - "\uC544\uBB34\uB9D0 \uC5C6\uC774 \uC120\uBB3C\uC744 \uBC14\uB2E5\uC5D0 \uB450\uACE0
    \uC790\uB9AC\uB97C \uB5A0\uB098\uC694"
  - "\"\uB098\uB97C \uC0DD\uAC01\uD574\uC11C \uC120\uBB3C\uC744 \uC900\uBE44\uD574\uC8FC\uC5C8\uB2E4\uB2C8
    \uC815\uB9D0 \uACE0\uB9C8\uC6CC\"\uB77C\uACE0 \uC774\uC57C\uAE30 \uD574\uC694"
  - "\uC548\uB155! \uB098\uB294 \uB204\uB9AC\uB77C\uACE0 \uD574. \uC6B0\uB9AC \uCE5C\uAD6C\uD558\uC9C0
    \uC54A\uC744\uB798? \uB77C\uACE0 \uB9D0\uD574\uC694."
  - "\uBCF4\uB78C\uC544 \uC548\uB155! \uB108 1\uBC18 \uB9DE\uC9C0? \uB098\uB294 3\uBC18
    \uB204\uB9AC\uC778\uB370, \uC6B0\uB9AC \uAC19\uC774 \uB180\uAE4C? \uB77C\uACE0
    \uB9D0\uD574\uC694."
  - "\uB098\uB294 \uB108\uAC00 \uC88B\uC544~ \uAC19\uC774 \uCE5C\uD558\uAC8C \uC9C0\uB0B4\uC790
    \uB77C\uACE0 \uB9D0\uD574\uC694."
  - "'\uADF8\uB7FC \uC544\uB974\uBC14\uC774\uD2B8\uB97C \uADF8\uB9CC \uB458\uAC8C\uC694'\uB77C\uACE0
    \uB9D0\uD558\uACE0 \uB098\uC640\uC694"
  - "'\uC54C\uACA0\uC5B4\uC694.'\uB77C\uACE0 \uB9D0\uD558\uACE0 \uC544\uC27D\uC9C0\uB9CC
    \uCE5C\uAD6C\uC640\uC758 \uC57D\uC18D\uC744 \uB2E4\uB978 \uB0A0\uB85C \uBBF8\uB904\uC694"
  - "'\uC8C4\uC1A1\uD55C\uB370 \uD639\uC2DC \uB0B4\uC77C \uC548\uB098\uC624\uB294
    \uB300\uC2E0 \uC8FC\uB9D0\uC5D0 \uB354 \uBC14\uC05C\uB0A0 \uD558\uB8E8 \uB354
    \uC77C\uD558\uB294 \uAC74 \uC548\uB420\uAE4C\uC694?\" \uB77C\uACE0 \uC815\uC911\uD558\uAC8C
    \uC5EC\uCB64\uBD10\uC694"
  - "'\uC120\uC0DD\uB2D8\uC774 \uC57D\uC18D\uC744 \uC9C0\uD0A4\uC9C0 \uC54A\uC73C\uC168\uC73C\uB2C8
    \uADF8\uB0E5 \uAC00\uC57C\uACA0\uB2E4'\uB77C\uACE0 \uC0DD\uAC01\uD558\uACE0 \uC9D1\uC73C\uB85C
    \uAC00\uC694."
  - "\uBB38\uC744 \uC5F4\uACE0 \uD070 \uC18C\uB9AC\uB85C \"\uC120\uC0DD\uB2D8, \uC57D\uC18D
    \uC2DC\uAC04\uC774 \uC9C0\uB0AC\uC5B4\uC694, \uC5BC\uB978 \uB05D\uB0B4\uC8FC\uC138\uC694\"\uB77C\uACE0
    \uC678\uCCD0\uC694.. "
  - "\uB611\uB611 \uB178\uD06C\uB97C \uD55C \uD6C4\uC5D0 \uBB38\uC744 \uC5F4\uACE0
    \" \uC120\uC0DD\uB2D8, \uC800 \uB3C4\uCC29\uD588\uB294\uB370 \uC5EC\uAE30\uC11C
    \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC744\uAC8C\uC694\"\uB77C\uACE0 \uB9D0\uC500\uC744
    \uB4DC\uB824\uC694."
  - "\"\uBB50 \uD558\uACE0 \uB178\uB294\uAC70\uC57C? \uB098\uB3C4 \uAC19\uC774 \uB180\uC544\uB3C4
    \uB420\uAE4C?\"\uB77C\uACE0 \uB9D0\uD574\uC694"
  - "\"\uB098\uB3C4 \uCE74\uB4DC\uB180\uC774 \uC88B\uC544\uD558\uB294\uB370...\"
    \uC791\uC740 \uC18C\uB9AC\uB85C \uB9D0\uD574\uC694"
  - "\"\uB098\uB3C4 \uCE74\uB4DC \uC918\" \uB77C\uACE0 \uB9D0\uD558\uBA70 \uAC19\uC774
    \uB180\uC544\uC694"
  - "\uC544\uBB34\uB9D0 \uC5C6\uC774 \uD560\uBA38\uB2C8 \uC9D0\uC744 \uBC1B\uC544
    \uB4E4\uACE0 \uC55E\uC11C\uC11C \uAC00\uC694."
  - "\"\uD560\uBA38\uB2C8! \uC81C\uAC00 \uB3C4\uC640\uB4DC\uB824\uB3C4 \uB420\uAE4C\uC694?\"\uB77C\uACE0
    \uC5EC\uCB64\uBCF4\uACE0 \uB3C4\uC6C0\uC744 \uB4DC\uB824\uC694"
  - "\"\uD560\uBA38\uB2C8 \uC800 \uD798 \uC544\uC8FC \uC138\uC694!\"\uB77C\uACE0
    \uB9D0\uD558\uBA70 \uC54C\uD1B5\uC744 \uBCF4\uC774\uB294 \uC2DC\uB289\uC744 \uD574\uC694."
  - "\"\uC544\uC774 \uC9DC\uC99D\uB098, \uC548\uBA39\uC5B4\"\uB77C\uACE0 \uC678\uCE58\uACE0
    \uC6B8\uC5B4\uC694. "
  - "\"\uC5EC\uAE30\uC694, \uB0B4\uAC00 \uC8FC\uBB38\uD55C\uAC8C \uC544\uB2C8\uC796\uC544\uC694\"
    \uB77C\uACE0 \uC2DD\uB2F9 \uC9C1\uC6D0\uC5D0\uAC8C \uD654\uB97C \uB0B4\uC694."
  - "\"\uC7A0\uC2DC\uB9CC\uC694, \uC81C\uAC00 \uC8FC\uBB38\uD55C \uAC83\uC740 \uC0D0\uB7EC\uB4DC\uAC00
    \uC544\uB2C8\uB77C \uAC10\uC790\uD280\uAE40\uC778\uB370 \uC798\uBABB \uB098\uC628
    \uAC83 \uAC19\uC544\uC694\" \uB77C\uACE0 \uCC28\uBD84\uD788 \uB9D0\uD574\uC694. "
  - "\"\uC544\uC27D\uC9C0\uB9CC \uB298\uBD04\uB3D9\uBB3C\uC5D0\uB294 \uC2E0\uAE30\uD55C
    \uB3D9\uBB3C\uB4E4\uC774 \uD558\uB098\uB3C4 \uC5C6\uB124\"\uB77C\uACE0 \uB9D0\uD574\uC694."
  - "\"\uB2E4\uC74C\uBC88\uC5D0\uB294 \uB2E4\uBE5B\uB3D9\uBB3C\uC6D0\uC5D0\uB3C4
    \uAC00\uBD10. \uC885\uB958\uAC00 \uB354 \uB9CE\uB354\uB77C\uAD6C\"\uB77C\uACE0
    \uB9D0\uD574\uC694."
  - "\"\uB298\uBD04\uB3D9\uBB3C\uC6D0\uC5D0\uB294 \uCF54\uB07C\uB9AC\uB791 \uAE30\uB9B0\uC774
    \uC788\uAD6C\uB098~ \uB2E4\uBE5B\uB3D9\uBB3C\uC6D0\uC5D0\uB294 \uC5EC\uB7EC \uC885\uB958\uC758
    \uD638\uB791\uC774\uAC00 \uC788\uC5B4\"\uB77C\uACE0 \uB9D0\uD574\uC694."
  - "\"\uB098\uB798\uC57C, \uD558\uC9C0\uB9C8! \uAE30\uBD84\uB098\uBE60\"\uB77C\uACE0
    \uB9D0\uD574\uC694."
  - "\"\uC5B4\uCC98\uAD6C\uB2C8\uAC00 \uC5C6\uC5B4\uC11C, \uB10C \uB3FC\uC9C0\uAC19\uC774
    \uC0DD\uACBC\uC796\uC544!\"\uB77C\uACE0 \uB9D0\uD574\uC694."
  - "\"\uB098\uB798\uC57C, \uB124\uAC00 \uADF8\uB807\uAC8C \uB9D0\uD574\uC11C \uB108\uBB34
    \uC18D\uC0C1\uD574, \uADF8\uB9CC\uD574 \uC8FC\uBA74 \uC88B\uACA0\uC5B4\""
  - "\"\uC544\uC800\uC528, \uC81C \uB9D0\uC774 \uC548\uB4E4\uB9AC\uC138\uC694?, \uC7A0\uAE50\uC774\uBA74
    \uB41C\uB2E4\uAD6C\uC694\"\uB77C\uACE0 \uB354 \uD06C\uAC8C \uB9D0\uD574\uC694."
  - "\"\uC544 \uC9DC\uC99D\uB098, \uC544\uC800\uC528\uAC00 \uB0A0 \uBB34\uC2DC\uD588\uC5B4\"\uB77C\uACE0
    \uB9D0\uD558\uBA70 \uBC16\uC73C\uB85C \uB098\uAC00\uC694."
  - "\uC7A0\uC2DC \uC11C\uC810\uC744 \uB458\uB7EC\uBCF4\uBA70 \uAE30\uB2E4\uB9B0
    \uD6C4 \uC0AC\uC7A5\uB2D8 \uD1B5\uD654\uAC00 \uB05D\uB098\uBA74 \uB2E4\uC2DC
    \uBB3C\uC5B4\uBD10\uC694 "
  - "\"\uC544 \uC815\uB9D0 \uC9DC\uC99D\uB098\" \uD654\uB0B4\uBA70 \uC9D1 \uBC16\uC73C\uB85C
    \uB098\uAC00\uC694. "
  - "\"\uC81C\uAC00 \uC798\uBABB\uD588\uC5B4\uC694\" \uB77C\uACE0 \uB9D0\uD558\uACE0
    \uBC29\uC744 \uCE58\uC6B0\uAE30 \uC2DC\uC791\uD574\uC694. "
  - "\"\uC815\uB9D0 \uB108\uBB34\uD574\uC694\" \uC9DC\uC99D\uB0B4\uB4EF \uB9D0\uD558\uACE0
    \uCE68\uB300\uC5D0 \uB204\uC6CC\uC694."
  - "\"\uC774\uB807\uAC8C \uC2F8\uC6B8\uAC70\uBA74 \uC0DD\uC77C\uD30C\uD2F0 \uD558\uC9C0
    \uB9D0\uC790\"\uB77C\uACE0 \uC774\uC57C\uAE30\uD574\uC694. "
  - "\"\uADF8\uB7FC \uC6B0\uB9AC \uC1A1\uC774\uC5D0\uAC8C \uBB34\uC5C7\uC774 \uC88B\uC744\uC9C0
    \uBB3C\uC5B4\uBCF4\uBA74 \uC5B4\uB5A8\uAE4C\"\uB77C\uACE0 \uC598\uAE30\uD558\uACE0
    \uB098\uC911\uC5D0 \uACB0\uC815\uD574\uC694. "
  - "\"\uADF8\uB7FC \uC6B0\uB9AC \uD55C \uC0AC\uB78C\uC774 \uC120\uBB3C\uC744 \uACE0\uB974\uACE0,
    \uB2E4\uB978 \uC0AC\uB78C\uC740 \uCF00\uC774\uD06C\uB97C \uACE0\uB974\uAE30\uB85C
    \uD558\uBA74 \uC5B4\uB5A8\uAE4C?\"\uB77C\uACE0 \uC81C\uC548\uD574 \uBD10\uC694."
  - "\"\uC5C4\uB9C8! \uADF8\uB7FC \uC800 10\uBD84\uB9CC \uB354 \uB180\uB2E4 \uAC00\uB3C4
    \uB420\uAE4C\uC694\" \uB77C\uACE0 \uB9D0\uD574\uC694 "
  - "\"\uB09C \uB354 \uB180\uB2E4 \uAC08\uAC70\uC5D0\uC694\" \uB77C\uACE0 \uB9D0\uD558\uACE0
    \uADF8\uB0E5 \uC804\uD654\uB97C \uB04A\uC5B4\uC694. "
  - "\"\uC54C\uC558\uC5B4\uC694\" \uB77C\uACE0 \uB9D0\uD558\uACE0 \uB610 \uB180\uB7EC\uC624\uAE30\uB85C
    \uC57D\uC18D\uD55C\uD6C4 \uC9D1\uC73C\uB85C \uAC00\uC694."
  - "\"\uC6B0\uB9AC \uD300\uC774 \uC838\uC11C \uB108\uBB34 \uC2AC\uD37C, \uADF8\uB798\uB3C4
    \uC5F4\uC2EC\uD788 \uD558\uB290\uB77C \uBAA8\uB450 \uC218\uACE0\uD588\uC5B4!\"\uB77C\uACE0
    \uAC19\uC740 \uD300 \uCE5C\uAD6C\uB4E4\uC5D0\uAC8C \uC598\uAE30\uD574\uC694. "
  - "\"\uCD95\uD558\uD574, \uC7AC\uBC0C\uB294 \uAC8C\uC784\uC774\uC5C8\uC5B4!\"\uB77C\uACE0
    \uB9D0\uD558\uBA70 \uCD95\uD558\uD574 \uC918\uC694. "
  - "\"\uAC8C\uC784\uC774 \uD558\uB098\uB3C4 \uC7AC\uBBF8\uAC00 \uC5C6\uB124\"\uB77C\uACE0
    \uB9D0\uD558\uBA70 \uC790\uB9AC\uB97C \uB5A0\uB098\uC694. "
  - "\"\uC8FC\uB9D0\uC740 \uC8FC\uB9D0\uC774\uACE0 \uC624\uB298\uC740 \uC219\uC81C\uB97C
    \uC798\uD558\uB294\uAC8C \uC911\uC694\uD558\uC796\uC544!\"\uB77C\uACE0 \uB9D0\uD574\uC694. "
  - "\"\uC624 \uC7AC\uBC0C\uACA0\uB2E4! \uB098\uB3C4 \uC9C0\uB09C \uC8FC\uB9D0\uC5D0
    \uC218\uC871\uAD00\uC5D0 \uB2E4\uB140\uC654\uB294\uB370\"\uB77C\uACE0 \uB9D0\uD574\uC694."
  - "\"\uC557, \uBBF8\uC548 \uC219\uC81C \uAC71\uC815\uC744 \uACC4\uC18D \uD558\uB2E4\uBCF4\uB2C8
    \uADF8 \uB9D0\uC774 \uBA3C\uC800 \uB098\uC640\uBC84\uB838\uB124\" \uB77C\uACE0
    \uB9D0\uD574\uC694."
  - "\"\uC544\uC800\uC528\uB3C4 \uC55E\uC744 \uC798 \uBCF4\uC168\uC5B4\uC57C\uC8E0!\"\uB77C\uACE0
    \uB9D0\uD574\uC694."
  - "\"\uC8C4\uC1A1\uD574\uC694, \uC5B4\uB514 \uB2E4\uCE58\uC2E0 \uB370\uB294 \uC5C6\uC73C\uC138\uC694?\"\uB77C\uACE0
    \uBB3C\uC5B4\uBD10\uC694."
  - "\"\uC548 \uBD80\uB52A\uD614\uC73C\uB2C8 \uAD1C\uCC2E\uC544\uC694\"\uB77C\uACE0
    \uB9D0\uD558\uACE0 \uC9C0\uB098\uAC00\uC694."
  - "\uBCFC\uD39C\uC744 \uBE8F\uC5B4\uC11C \uCE5C\uAD6C \uD314\uC5D0\uB3C4 \uB611\uAC19\uC774
    \uB099\uC11C\uD574 \uC918\uC694. "
  - "\uCE5C\uAD6C\uC758 \uB208\uC744 \uBCF4\uACE0 \"\uADF8\uB9CC\uD574, \uC815\uB9D0
    \uAE30\uBD84 \uB098\uBE60!\" \uB77C\uACE0 \uB9D0\uD574\uC694. "
  - "\uC120\uC0DD\uB2D8\uC5D0\uAC8C \"\uCE5C\uAD6C\uB4E4\uC774 \uC624\uC9D5\uC5B4\uB77C\uACE0
    \uB180\uB9AC\uACE0 \uD314\uC5D0 \uB099\uC11C\uD588\uC5B4\uC694\"\uB77C\uACE0
    \uB9D0\uC500\uB4DC\uB824\uC694."
  - "\"\uC774\uC81C \uB178\uB798\uB294 \uD558\uAE30 \uC2EB\uC5B4\"\uB77C\uACE0 \uB9D0\uD558\uBA70
    \uB178\uB798 \uBC30\uC6B0\uB358 \uAC83\uC744 \uAD00\uB46C\uC694. "
  - "\"\uC815\uB9D0 \uC5F4\uC2EC\uD788 \uD588\uB294\uB370 \uB9C8\uC74C\uB300\uB85C
    \uC548\uB418\uC11C \uB108\uBB34 \uC18D\uC0C1\uD574\"\uB77C\uACE0 \uB9D0\uD558\uBA70
    \uB098\uB798\uC5D0\uAC8C \uC18D\uC0C1\uD55C \uB9C8\uC74C\uC744 \uC774\uC57C\uAE30
    \uD574\uC694. "
  - "\"\uB2E4\uC2DC \uC0DD\uAC01\uD574 \uBCF4\uB2C8 \uB178\uB798\uAC00 \uC5B4\uB824\uC6E0\uB358
    \uAC83 \uCE58\uACE0\uB294 \uB098\uB984 \uC798\uD588\uB358 \uAC83\uB3C4 \uAC19\uB124\"
    \uB77C\uACE0 \uB9D0\uD558\uBA70 \uC2E4\uC218\uB9CC \uB5A0\uC62C\uB9AC\uC9C0 \uB9D0\uACE0
    \uC798 \uD588\uB358 \uBD80\uBD84\uC5D0 \uB300\uD574 \uC0DD\uAC01\uD574 \uBD10\uC694."
  - "\"\uCE6B, \uB108\uBB34\uD574! \uB098\uB3C4 \uC55E\uC73C\uB85C \uB124 \uBD80\uD0C1
    \uB4E4\uC5B4\uC8FC\uB098\uBD10\uB77C\"\uB77C\uACE0 \uD654\uB97C \uB0B4\uC694."
  - "\"\uB124 \uC9D0\uC744 \uB0B4\uAC00 \uBABB\uBD24\uB124, \uAD1C\uCC2E\uC544. \uB2E4\uB978
    \uCE5C\uAD6C\uAC00 \uACE7 \uC624\uACA0\uC9C0\"\uB77C\uACE0 \uB9D0\uD574\uC694. "
  - "\"\uADF8\uB807\uB124, \uADF8\uB7FC \uB0B4 \uCC45\uB9CC \uB4E4\uC5B4\uC8FC\uBA74
    \uB0B4\uAC00 \uAC00\uBC29\uC744 \uC5B4\uAE68\uC5D0 \uBA54\uC5B4\uBCFC \uC218
    \uC788\uC744 \uAC83 \uAC19\uC740\uB370 \uC5B4\uB54C?\"\uB77C\uACE0 \uB9D0\uD574\uC694."
  - "\"\uC548 \uC7A1\uC544\uC8FC\uC154\uB3C4 \uB418\uB294\uB370\uC694\"\uB77C\uACE0
    \uB9D0\uD574\uC694"
  - "(\uACE0\uAC1C\uB97C \uB044\uB355\uC5EC \uC778\uC0AC\uB97C \uD558\uBA74\uC11C)
    \"\uAC10\uC0AC\uD569\uB2C8\uB2E4\"\uB77C\uACE0 \uB9D0\uD574\uC694"
  - "\uC5B4\uC0C9\uD558\uB2C8\uAE4C \uC544\uBB34\uB9D0 \uC5C6\uC774 \uC9C0\uB098\uAC00\uC694."
  - "\"\uB0B4 \uB9D0\uC744 \uADF8\uB807\uAC8C \uBB34\uC2DC\uD558\uB2E4\uB2C8. \uB09C
    \uD569\uCC3D \uC548\uD560\uB798\"\uB77C\uACE0 \uB9D0\uD574\uC694"
  - "\"\uADF8\uB7FC \uB108\uD76C\uAC00 \uC6D0\uD558\uB294 \uB178\uB798\uB294 \uBB50\uC57C?\"\uB77C\uACE0
    \uBB3C\uC5B4\uBD10\uC694."
  - "\"\uC77C\uB2E8 \uB0B4\uAC00 \uC0DD\uAC01\uD558\uB294 \uB178\uB798 \uD55C \uBC88
    \uAC19\uC774 \uB4E4\uC5B4\uBCF4\uACE0\uB098\uC11C \uC598\uAE30\uD558\uBA74 \uC5B4\uB54C?\"\uB77C\uACE0
    \uB9D0\uD574\uC694."
  - "\"\uBBF8\uC548\uBBF8\uC548, \uBBF8\uC548\uD558\uB2E4\uACE0 \uD558\uC796\uC544\"
    \uB77C\uACE0 \uB9D0\uD574\uC694."
  - "\"\uADF8\uB7F0\uB370 \uC5B4\uCC28\uD53C \uBAA8\uB450 \uC54C\uAC8C \uB420 \uC77C\uC774\uC5C8\uC796\uC544\"\uB77C\uACE0
    \uB9D0\uD574\uC694."
  - "\"\uB098\uB798\uC57C, \uC815\uB9D0 \uBBF8\uC548\uD574. \uB0B4\uAC00 \uC798\uBABB\uD588\uC5B4\"
    \uB77C\uACE0 \uC9C4\uC2EC\uC73C\uB85C \uC0AC\uACFC\uD574\uC694."
  - "\"\uB098\uB3C4 \uAC1C\uADF8 \uD504\uB85C\uADF8\uB7A8 \uC88B\uC544\uD558\uB294\uB370,
    \uBABB\uBD10\uC11C \uC544\uC27D\uB2E4\"\uB77C\uACE0 \uB9D0\uD574\uC694."
  - "\"\uB108\uD76C\uB294 \uACF5\uACF5\uC7A5\uC18C\uC5D0\uC11C \uC870\uC6A9\uD788
    \uD574\uC57C\uD558\uB294\uAC83\uB3C4 \uBAA8\uB974\uB2C8?\"\uB77C\uACE0 \uD070
    \uC18C\uB9AC\uB85C \uB9D0\uD574\uC694"
  - "\"\uC598\uB4E4\uC544 \uC5EC\uB7EC\uC0AC\uB78C\uC774 \uC788\uB294 \uACF5\uAC04\uC778\uB370
    \uC870\uAE08 \uC870\uC6A9\uD788 \uC598\uAE30\uD574 \uC904 \uC218 \uC788\uC744\uAE4C?\"\uB77C\uACE0
    \uB9D0\uD574\uC694."
  - "\"\uB124\"\uB77C\uACE0 \uB9D0\uD558\uBA70 \uACE0\uAC2F\uC9D3\uC73C\uB85C \uC778\uC0AC\uD558\uACE0
    \uB098\uB798 \uBC29\uC73C\uB85C \uAC00\uC694."
  - "\"\uC548\uB155\uD558\uC138\uC694! \uC1A1\uC774 \uBC29\uC5D0\uC11C \uB180\uAEC0\uB370
    \uAC04\uC2DD \uC880 \uC8FC\uC2E4 \uC218 \uC788\uC73C\uC138\uC694?\"\uB77C\uACE0
    \uBB3C\uC5B4\uBD10\uC694."
  - "\"\uB124, \uC1A1\uC774 \uC5B4\uBA38\uB2C8 \uC548\uB155\uD558\uC138\uC694! \uC800\uB294
    \uB098\uB798\uB77C\uACE0 \uD569\uB2C8\uB2E4. \uC1A1\uC774 \uBC29\uC5D0\uC11C
    \uB180\uB2E4 \uAC00\uB3C4 \uB420\uAE4C\uC694?\"\uB77C\uACE0 \uB9D0\uD574\uC694. "
  instructions:
  - "\uB124, \uC774\uB807\uAC8C \uC0C1\uB300\uBC29\uC5D0\uAC8C \uBB34\uC5C7\uC744
    \uC798\uBABB\uD588\uB294\uC9C0 \uB9D0\uD560 \uC218\uB294 \uC788\uC5B4\uC694.
    \uD558\uC9C0\uB9CC \uB354 \uC88B\uC740 \uBC29\uBC95 \uB3C4 \uC788\uC73C\uB2C8
    \uB2E4\uB978 \uC120\uD0DD\uC744 \uD574\uBCF4\uC138\uC694"
  - "\uD558\uD558, \uB9DE\uC544\uC694! \uBB34\uC5C7\uC744 \uC798\uBABB \uD588\uB294\uC9C0
    \uC9C0\uC801\uD558\uAE30 \uBCF4\uB2E4\uB294 \uD574\uACB0\uD560 \uC218 \uC788\uB294
    \uBC29\uBC95\uC774\uB098 \uBD80\uD0C1\uC744 \uD558\uB4EF \uB9D0\uD558\uB294 \uAC83\uC774
    \uB354 \uC88B\uC740 \uBC29\uBC95\uC774\uC5D0\uC694. "
  - "\uC774\uB7F0~ \uC815\uB2F5\uC774 \uC544\uB2C8\uC5D0\uC694. \uAC00\uB9CC\uD788
    \uC788\uB294\uB2E4\uACE0 \uBB38\uC81C\uAC00 \uD574\uACB0 \uB418\uC9C0\uB294 \uC54A\uC9C0\uC694.
    \uB2E4\uC2DC \uC120\uD0DD\uD574 \uBCF4\uC138\uC694."
  - "\uC774\uB7F0, \uC815\uB2F5\uC774 \uC544\uB2C8\uC5D0\uC694. \uCE5C\uAD6C\uAC00
    \uC18D\uC0C1\uD574 \uD558\uACE0 \uC788\uB294\uB370 \uCE5C\uAD6C\uC758 \uB9C8\uC74C\uC744
    \uC54C\uC544\uC8FC\uAC70\uB098 \uB3C4\uC6C0\uC744 \uC8FC\uBA74 \uC5B4\uB5A8\uAE4C\uC694?
    \uB2E4\uC2DC \uC120\uD0DD\uD574 \uBCF4\uC138\uC694."
  - "\uB9DE\uC544\uC694, \uC0C1\uB300\uBC29\uC758 \uB9C8\uC74C\uC744 \uC798 \uC77D\uC5B4\uC8FC\uACE0
    \uB3C4\uC640\uC8FC\uB824\uACE0 \uD55C \uC88B\uC740 \uB2F5\uBCC0\uC785\uB2C8\uB2E4. "
  - "\uC774\uB7F0, \uC815\uB2F5\uC774 \uC544\uB2C8\uC5D0\uC694. \uBC14\uC058\uC9C0
    \uC54A\uB2E4\uBA74 \uAC19\uC774 \uB3C4\uC640\uC8FC\uBA74 \uC88B\uACA0\uC9C0\uB9CC,
    \uAE09\uD55C \uC77C\uC774 \uC788\uB2E4\uBA74 \uC65C \uB3C4\uC6C0\uC744 \uC904
    \uC218 \uC5C6\uB294\uC9C0 \uBA3C\uC800 \uC124\uBA85\uD574 \uC8FC\uB294\uAC83\uC774
    \uC88B\uC9C0 \uC54A\uC744\uAE4C\uC694? \uB2E4\uC2DC \uC120\uD0DD\uD574 \uBCF4\uC138\uC694."
  - "\uC774\uB7F0, \uC815\uB2F5\uC774 \uC544\uB2C8\uC5D0\uC694. \uC2E4\uC218 \uD560
    \uB54C\uB9C8\uB2E4 \uC55E\uC73C\uB85C \uC544\uBB34\uAC83\uB3C4 \uD558\uC9C0 \uC54A\uACA0\uB2E4\uACE0
    \uC0DD\uAC01\uD558\uBA74 \uACFC\uC5F0 \uBB34\uC5C7\uC744 \uD560 \uC218 \uC788\uC744\uAE4C\uC694?
    \uB2E4\uC2DC \uC120\uD0DD\uD574\uBCF4\uC138\uC694."
  - "\uB9DE\uC544\uC694. \uC0AC\uB78C\uC740 \uB204\uAD6C\uB098 \uC2E4\uC218\uB97C
    \uD560 \uC218 \uC788\uC73C\uB2C8 \uB108\uBB34 \uC18D\uC0C1\uD574\uD558\uC9C0
    \uC54A\uC544\uB3C4 \uB41C\uB2F5\uB2C8\uB2E4."
  - "\uB9DE\uC544\uC694. \uB2E4\uC74C\uBC88\uC5D0 \uB354 \uC798\uD560 \uC218 \uC788\uB3C4\uB85D
    \uB178\uB825\uD558\uB294 \uAC83\uC740 \uC88B\uC740 \uBC29\uBC95\uC774\uC5D0\uC694.
    \uD558\uC9C0\uB9CC \uB204\uAD6C\uB098 \uC2E4\uC218\uB97C \uD560 \uC218 \uC788\uB2E4\uB294
    \uAC83\uC744 \uC544\uB294 \uAC83\uB3C4 \uC911\uC694\uD558\uB2F5\uB2C8\uB2E4!"
  - "\uC774\uB7F0, \uC815\uB2F5\uC774 \uC544\uB2C8\uC5D0\uC694. \uC774\uAC74 \uBD80\uD0C1\uC774
    \uC544\uB2C8\uB77C \uBA85\uB839\uD558\uB294 \uAC83 \uCC98\uB7FC \uB4E4\uB9AC\uB124\uC694.
    \uB2E4\uC2DC \uC120\uD0DD\uD574 \uBCF4\uC138\uC694."
  - "\uC774\uB7F0, \uC815\uB2F5\uC774 \uC544\uB2C8\uC5D0\uC694. \uCE5C\uD55C \uCE5C\uAD6C\uB77C
    \uD558\uB354\uB77C\uB3C4 \uBA3C\uC800 \uBB3C\uC5B4\uBCF8 \uD6C4\uC5D0 \uB9CC\uC838\uBCF4\uB294
    \uAC83\uC774 \uC88B\uC544\uC694. \uB2E4\uC2DC \uC120\uD0DD\uD574 \uBCF4\uC138\uC694."
  - "\uB9DE\uC544\uC694, \uB0A8\uC758 \uBB3C\uAC74\uC744 \uB9CC\uC838\uBCF4\uAE30
    \uC804\uC5D0 \uB298 \uC8FC\uC778\uC758 \uD5C8\uB77D\uC744 \uBA3C\uC800 \uAD6C\uD574\uC57C
    \uD55C\uB2F5\uB2C8\uB2E4. \uADF8\uB9AC\uACE0 \uBD80\uD0C1\uC744 \uAC70\uC808\uD558\uB354\uB77C\uB3C4
    \uCE5C\uAD6C\uC758 \uB9C8\uC74C\uC744 \uC874\uC911\uD574 \uC8FC\uC5B4\uC57C \uD574\uC694. "
  - "\uC774\uB7F0, \uC815\uB2F5\uC774 \uC544\uB2C8\uC5D0\uC694. \uAC8C\uC784\uC774
    \uC911\uC694\uD55C\uC9C0 \uCE5C\uAD6C\uAC00 \uC911\uC694\uD55C\uC9C0 \uC798 \uC0DD\uAC01\uD574\uBCF4\uBA74
    \uC88B\uACA0\uC5B4\uC694. \uB2E4\uC2DC \uC120\uD0DD\uD574 \uBCF4\uC138\uC694."
  - "\uB9DE\uC544\uC694. \uCE5C\uAD6C\uC640 \uD568\uAED8 \uC788\uC744 \uB54C\uB294 
    \uD63C\uC790\uB9CC \uD560 \uC218 \uC788\uB294 \uB180\uC774\uB97C \uD558\uBA74
    \uC548\uB418\uC8E0. \uADF8\uB9AC\uACE0 \uB9D0\uC744 \uC798 \uBABB\uB4E4\uC5C8\uC73C\uBA74
    \uC0AC\uACFC\uB97C \uD558\uACE0 \uB2E4\uC2DC \uC598\uAE30\uD574 \uC904 \uAC83\uC744
    \uBD80\uD0C1\uD558\uB294 \uAC83\uC774 \uC88B\uC2B5\uB2C8\uB2E4. "
  - "\uC774\uB7F0, \uC815\uB2F5\uC774 \uC544\uB2C8\uC5D0\uC694. \uCE5C\uAD6C\uC758
    \uD45C\uC815\uC744 \uBCF4\uACE0 \uCE5C\uAD6C\uAC00 \uC6D0\uD558\uB294 \uAC83\uC774
    \uBB34\uC5C7\uC77C\uC9C0 \uC798 \uC0DD\uAC01\uD574 \uBCF4\uACE0 \uB2E4\uC2DC
    \uC120\uD0DD\uD574 \uBCF4\uC138\uC694."
  - "\uC774\uB7F0, \uC815\uB2F5\uC774 \uC544\uB2C8\uC5D0\uC694. \uADF8\uB0E5 \uB450\uACE0
    \uAC00\uBA74 \uC5EC\uB7EC \uC0AC\uB78C\uC774 \uC544\uC774\uC2A4\uD06C\uB9BC\uC744
    \uBC1F\uACE0 \uB354 \uB354\uB7EC\uC6CC\uC9C0\uAC70\uB098 \uBBF8\uB044\uB7EC\uC838
    \uB2E4\uCE60 \uC218\uB3C4 \uC788\uC5B4\uC694. \uB2E4\uC2DC \uC120\uD0DD\uD574
    \uBCF4\uC138\uC694."
  - "\uD6CC\uB96D\uD55C \uC120\uD0DD\uC774\uC5D0\uC694. \uC9C1\uC811 \uD574\uACB0\uD574
    \uBCF4\uB294\uAC83\uB3C4 \uC88B\uACA0\uC9C0\uB9CC \uC5B4\uB824\uC6B4 \uC0C1\uD669\uC5D0\uC11C\uB294
    \uB3C4\uC6C0\uC744 \uC694\uCCAD\uD558\uB294 \uAC83\uB3C4 \uC88B\uC740 \uBC29\uBC95\uC774\uC5D0\uC694. "
  - "\uD6CC\uB96D\uD55C \uC120\uD0DD\uC774\uC5D0\uC694. \uC9C1\uC811 \uD574\uACB0\uD574
    \uBCF4\uB294\uAC83\uB3C4 \uC88B\uACA0\uC9C0\uB9CC \uC5B4\uB824\uC6B4 \uC0C1\uD669\uC5D0\uC11C\uB294
    \uB3C4\uC6C0\uC744 \uC694\uCCAD\uD558\uB294 \uAC83\uB3C4 \uC88B\uC740 \uBC29\uBC95\uC774\uC5D0\uC694. "
  - "\uC774\uB7F0, \uC815\uB2F5\uC774 \uC544\uB2C8\uC608\uC694. \uB108\uBB34 \uAE34
    \uC2DC\uAC04\uC774 \uC544\uB2C8\uB354\uB77C\uB3C4 \uC544\uBB34 \uB9D0 \uC5C6\uC774
    \uC57D\uC18D\uC5D0 \uB2A6\uAC8C\uB418\uBA74 \uCE5C\uAD6C\uAC00 \uAC71\uC815\uD560
    \uC218 \uC788\uC73C\uB2C8 \uC0C1\uD669\uC744 \uC598\uAE30\uD574 \uC8FC\uB294
    \uAC83\uC774 \uC88B\uC544\uC694. \uB2E4\uC2DC \uC120\uD0DD\uD574 \uBCF4\uC138\uC694. "
  - "\uB9DE\uC544\uC694. \uC57D\uC18D \uC2DC\uAC04\uC5D0 \uC870\uAE08 \uB2A6\uAC8C
    \uB41C\uB2E4\uBA74 \uCE5C\uAD6C\uC5D0\uAC8C \uC0C1\uD669\uC744 \uC124\uBA85\uD574
    \uC8FC\uACE0 \uC870\uAE08 \uAE30\uB2E4\uB824 \uB2EC\uB77C\uACE0 \uBD80\uD0C1\uD558\uBA74
    \uB418\uC694. \uCE5C\uAD6C\uAC00 20\uBD84 \uAE30\uB2E4\uB9AC\uB294\uAC8C \uD798\uB4E4
    \uAC83 \uAC19\uB2E4\uBA74 \uC774\uC57C\uAE30 \uD574\uC904\uAC70\uC5D0\uC694.
    \uC798 \uC120\uD0DD\uD588\uC5B4\uC694! "
  - "\uAC00\uB054 \uC57D\uC18D\uC2DC\uAC04\uC5D0 \uB2A6\uAC8C \uB420 \uC218\uB3C4
    \uC788\uC5B4\uC694. \uBC14\uB85C \uC57D\uC18D\uC744 \uCDE8\uC18C\uD558\uAE30
    \uBCF4\uB2E4\uB294 \uC0C1\uD669\uC744 \uC124\uBA85\uD558\uACE0 \uC2DC\uAC04\uC744
    \uC870\uC815\uD574 \uBCF4\uBA74 \uC5B4\uB5A8\uAE4C\uC694? \uB2E4\uB978 \uC120\uD0DD\uC744
    \uD574\uBCF4\uC138\uC694."
  - "\uC774\uB7F0, \uC815\uB2F5\uC774 \uC544\uB2C8\uC5D0\uC694. \uAC11\uC790\uAE30
    \uD070\uC18C\uB9AC\uB85C \"\uC2E4\uB840\uD569\uB2C8\uB2E4 \uBE44\uCF1C\uC8FC\uC138\uC694\"\uB77C\uACE0
    \uC678\uCE5C\uB2E4\uBA74 \uB2E4\uB978 \uC0AC\uB78C\uB4E4\uC774 \uB180\uB784 \uC218\uB3C4
    \uC788\uC5B4\uC694. \uB2E4\uC2DC \uC120\uD0DD\uD574\uBCF4\uC138\uC694."
  - "\uB9DE\uC544\uC694. \uC0AC\uB78C\uB4E4\uC774 \uB9CE\uC740 \uACF3\uC5D0\uC11C\uB294
    \"\uC2E4\uB840\uD569\uB2C8\uB2E4\"\uB77C\uACE0 \uC774\uC57C\uAE30\uD55C \uB4A4
    \uAE38\uC744 \uBE44\uCF1C\uC8FC\uBA74 \uAC78\uC5B4\uAC00\uB294 \uAC8C \uC88B\uC544\uC694."
  - "\uC774\uB7F0, \uC815\uB2F5\uC774 \uC544\uB2C8\uC5D0\uC694. \uC544\uBB34\uB9D0
    \uC5C6\uC774 \uC0AC\uB78C\uB4E4\uC774 \uB098\uAC08 \uB54C\uAE4C\uC9C0 \uAC00\uB9CC\uD788
    \uC11C\uC788\uB294 \uAC83\uC740 \uC88B\uC740 \uBC29\uBC95\uC774 \uC544\uB2C8\uC5D0\uC694.
    \uB2E4\uC2DC \uC120\uD0DD\uD574\uBCF4\uC138\uC694."
  - "\uC774\uB7F0, \uC815\uB2F5\uC774 \uC544\uB2C8\uC5D0\uC694. \uC194\uC9C1\uD558\uAC8C
    \uB9D0\uD558\uB294 \uAC83\uC740 \uC0C1\uB300\uBC29\uC758 \uAE30\uBD84\uC744 \uC0C1\uD558\uAC8C
    \uD560 \uC218 \uC788\uC5B4\uC694. \uB2E4\uC2DC \uC120\uD0DD\uD574\uBCF4\uC138\uC694."
  - "\uC774\uB7F0, \uC815\uB2F5\uC774 \uC544\uB2C8\uC5D0\uC694. \uC544\uBB34\uB9AC
    \uC120\uBB3C\uC774 \uB9C8\uC74C\uC5D0 \uB4E4\uC9C0 \uC54A\uB294\uB2E4\uACE0 \uD574\uB3C4
    \uC544\uBB34 \uB9D0 \uC5C6\uC774 \uC120\uBB3C\uC744 \uB450\uACE0\uAC00\uB294
    \uD589\uB3D9\uC740 \uCE5C\uAD6C\uC758 \uB9C8\uC74C\uC744 \uBB34\uC2DC\uD558\uB294
    \uD589\uB3D9\uC774\uC5D0\uC694. \uB2E4\uC2DC \uC120\uD0DD\uD574\uBCF4\uC138\uC694."
  - "\uB9DE\uC544\uC694. \uB0B4 \uB9C8\uC74C\uC5D0 \uB4E4\uC9C0 \uC54A\uB294 \uC120\uBB3C\uC774\uB77C\uB3C4
    \uB098\uB97C \uC0DD\uAC01\uD574\uC11C \uC900\uBE44\uD574\uC900 \uCE5C\uAD6C\uC5D0\uAC8C
    \uACE0\uB9C8\uC6C0\uC744 \uD45C\uD604\uD558\uB294 \uAC83\uC740 \uC0C1\uB300\uBC29\uC758
    \uB9C8\uC74C\uC744 \uBC30\uB824\uD558\uB294 \uBA4B\uC9C4 \uBAA8\uC2B5\uC774\uC5D0\uC694."
  - "\uB9DE\uC544\uC694, \uC0C8\uB85C\uC6B4 \uCE5C\uAD6C\uB97C \uB9CC\uB098\uBA74
    \uBA3C\uC800 \uC790\uC2E0\uC744 \uC774\uB984\uC744 \uB9D0\uD558\uACE0 \uB300\uD654\uB97C
    \uC2DC\uC791\uD558\uB294 \uAC8C \uC88B\uC544\uC694. \uADF8\uB9AC\uACE0 \uCC28\uCC28
    \uC870\uAE08\uC529 \uB354 \uC790\uC138\uD55C \uC774\uC57C\uAE30\uB97C \uD574
    \uC8FC\uB294\uAC83\uB3C4 \uC88B\uACA0\uC9C0\uC694. "
  - "\uB9DE\uC544\uC694, \uB0B4\uAC00 \uC5B4\uB514 \uC0AC\uB294\uC9C0, \uC5B4\uB5A4\uBC18\uC5D0
    \uB2E4\uB2C8\uB294\uC9C0 \uB4F1 \uC54C\uB824\uC8FC\uBA74 \uB354 \uC27D\uAC8C
    \uCE5C\uD574\uC9C8 \uC218 \uC788\uC5B4\uC694."
  - "\uC774\uB7F0, \uC815\uB2F5\uC774 \uC544\uB2C8\uC5D0\uC694. \uC0C1\uB300\uBC29\uACFC
    \uC778\uC0AC\uB3C4 \uD558\uC9C0 \uC54A\uACE0 \uAC11\uC790\uAE30 \uB2E4\uAC00\uAC00\uBA70
    \uC88B\uC544\uD55C\uB2E4\uACE0 \uD558\uBA74 \uBCF4\uB78C\uC774\uAC00 \uB2F9\uD669\uD560
    \uC218 \uC788\uC5B4\uC694. \uB2E4\uC2DC \uC120\uD0DD\uD574\uBCF4\uC138\uC694."
  - "\uC774\uB7F0, \uC815\uB2F5\uC774 \uC544\uB2C8\uC5D0\uC694. \uC774\uB7EC\uD55C
    \uC0C1\uD669\uC5D0\uC11C \uC77C\uBC29\uC801\uC73C\uB85C \uC544\uB974\uBC14\uC774\uD2B8\uB97C
    \uADF8\uB9CC\uB450\uB294 \uAC74 \uC88B\uC740 \uBC29\uBC95\uC774 \uC544\uB2C8\uC5D0\uC694.
    \uB2E4\uC2DC \uC120\uD0DD\uD574\uBCF4\uC138\uC694."
  - "\uB9DE\uC544\uC694. \uC544\uB974\uBC14\uC774\uD2B8 \uB610\uD55C \uC0AC\uC7A5\uB2D8\uACFC\uC758
    \uC57D\uC18D\uC774\uB2C8 \uBA3C\uC800 \uD55C \uC57D\uC18D\uC744 \uC9C0\uD0A4\uB294
    \uAC8C \uC88B\uC544\uC694."
  - "\uB9DE\uC544\uC694. \uC815\uB9D0 \uC911\uC694\uD55C \uC57D\uC18D\uC774\uB77C\uBA74
    \uC544\uB974\uBC14\uC774\uD2B8 \uC2DC\uAC04\uC744 \uC870\uC815\uD574\uBCFC \uC218
    \uC788\uB294\uC9C0 \uC0AC\uC7A5\uB2D8\uC5D0\uAC8C \uD55C\uBC88 \uB354 \uBB3C\uC5B4\uBCF4\uB294
    \uAC83\uB3C4 \uC88B\uC740 \uBC29\uBC95\uC774\uC5D0\uC694."
  - "\uC774\uB7F0, \uC815\uB2F5\uC774 \uC544\uB2C8\uC5D0\uC694. \uB9D0 \uC5C6\uC774
    \uAC00\uBC84\uB9AC\uB294 \uAC74 \uC88B\uC740 \uBC29\uBC95\uC774 \uC544\uB2C8\uC5D0\uC694.
    \uB2E4\uC2DC \uC120\uD0DD\uD574\uBCF4\uC138\uC694."
  - "\uC774\uB7F0, \uC815\uB2F5\uC774 \uC544\uB2C8\uC5D0\uC694. \uD070 \uC18C\uB9AC\uB85C
    \uB9D0\uC744 \uD558\uBA74 \uC120\uC0DD\uB2D8\uACFC \uB204\uB9AC\uAC00 \uB2F9\uD669\uD560
    \uC218\uB3C4 \uC788\uC5B4\uC694. \uB2E4\uC2DC \uC120\uD0DD\uD574\uBCF4\uC138\uC694."
  - "\uB9DE\uC544\uC694. \uB3C4\uCC29\uD588\uC74C\uC744 \uC54C\uB824\uB4DC\uB9AC\uBA74
    \uACE7 \uC120\uC0DD\uB2D8\uC774 \uB9C8\uBB34\uB9AC\uD558\uC2DC\uACE0 \uB9CC\uB098
    \uC8FC\uC2E4 \uAC70\uC608\uC694."
  - "\uB9DE\uC544\uC694. \uCE5C\uAD6C\uB4E4\uC5D0\uAC8C \uB180\uC774\uC5D0 \uB300\uD55C
    \uAD00\uC2EC\uC744 \uD45C\uD604\uD558\uACE0 \uBD80\uD0C1\uC744 \uD558\uBA74 \uCE5C\uAD6C\uB4E4\uC774
    \uD658\uC601\uD574 \uC904 \uC218 \uC788\uC5B4\uC694."
  - "\uB204\uB9AC\uB3C4 \uC88B\uC544\uD558\uB294 \uB180\uC774\uB77C\uACE0 \uC774\uC57C\uAE30\uD558\uBA74
    \uCE5C\uAD6C\uB4E4\uB3C4 \uB204\uB9AC\uC758 \uB9C8\uC74C\uC744 \uC54C\uC544\uCC44\uACE0
    \uCD08\uB300\uD560 \uC218\uB3C4 \uC788\uC5B4\uC694. \uD558\uC9C0\uB9CC \uC791\uC740
    \uC18C\uB9AC\uB85C \uB9D0\uD558\uBA74 \uBABB\uC54C\uC544 \uB4E4\uC744 \uC218
    \uC788\uC73C\uB2C8 \uB2E4\uC2DC \uC120\uD0DD\uD574 \uBCF4\uC138\uC694."
  - "\uC774\uB7F0, \uC815\uB2F5\uC774 \uC544\uB2C8\uC5D0\uC694. \uC544\uBB34\uB9D0
    \uC5C6\uC774 \uB180\uC774\uB97C \uD558\uAC8C \uB41C\uB2E4\uBA74 \uCE5C\uAD6C\uB4E4\uC774
    \uB2F9\uD669\uD560\uC9C0\uB3C4 \uBAB0\uB77C\uC694. \uB2E4\uC2DC \uC120\uD0DD\uD574\uBCF4\uC138\uC694."
  - "\uC774\uB7F0, \uC815\uB2F5\uC774 \uC544\uB2C8\uC5D0\uC694. \uC544\uBB34 \uB9D0
    \uC5C6\uC774 \uC9D0\uC744 \uB4E4\uC5B4\uB4DC\uB9B0\uB2E4\uBA74 \uD560\uBA38\uB2C8\uAC00
    \uB9E4\uC6B0 \uB2F9\uD669\uD558\uC2E4 \uC218 \uC788\uC5B4\uC694. \uB2E4\uC2DC
    \uC120\uD0DD\uD574\uBCF4\uC138\uC694."
  - "\uB9DE\uC544\uC694. \uB204\uAD70\uAC00\uB97C \uB3D5\uACE0 \uC2F6\uC744 \uB54C\uC5D0\uB294
    \uBA3C\uC800 \uC0C1\uB300\uBC29\uC5D0\uAC8C \uB3C4\uC6C0\uC744 \uC8FC\uC5B4\uB3C4
    \uB418\uB294\uC9C0 \uBB3C\uC5B4\uBD10\uC57C\uD574\uC694."
  - "\uC774\uB7F0, \uC815\uB2F5\uC774 \uC544\uB2C8\uC5D0\uC694. \uD560\uBA38\uB2C8\uB97C
    \uB3C4\uC640\uB4DC\uB9AC\uACE0 \uC2F6\uB2E4\uBA74 \uBD84\uBA85\uD558\uAC8C\uC5EC\uCB64\uBCF4\uACE0
    \uB3C4\uC640\uB4DC\uB824\uC57C \uD574\uC694. \uB2E4\uC2DC \uC120\uD0DD\uD574\uBCF4\uC138\uC694."
  - "\uC774\uB7F0, \uC815\uB2F5\uC774 \uC544\uB2C8\uC5D0\uC694. \uBB34\uD131\uB300\uACE0
    \uC6B0\uB294 \uAC74 \uC88B\uC740 \uBC29\uBC95\uC774 \uC544\uB2C8\uC5D0\uC694.
    \uB2E4\uC2DC \uC120\uD0DD\uD574\uBCF4\uC138\uC694."
  - "\uC774\uB7F0, \uC815\uB2F5\uC774 \uC544\uB2C8\uC5D0\uC694. \uC74C\uC2DD\uC774
    \uC798\uBABB \uB098\uC654\uB354\uB77C\uB3C4 \uC9C1\uC6D0\uC5D0\uAC8C \uD654\uB97C
    \uB0B4\uB294 \uAC74 \uC88B\uC740 \uBC29\uBC95\uC774 \uC544\uB2C8\uC5D0\uC694.
    \uB2E4\uC2DC \uC120\uD0DD\uD574\uBCF4\uC138\uC694."
  - "\uB9DE\uC544\uC694. \uC6D0\uD558\uB294 \uAC83\uACFC \uB2E4\uB978 \uACB0\uACFC\uAC00
    \uB098\uC654\uC744 \uB54C \uCE68\uCC29\uD558\uAC8C \uBD80\uD0C1\uC744 \uD558\uBA74
    \uB300\uBD80\uBD84 \uC798 \uD574\uACB0\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4. "
  - "\uC774\uB7F0, \uC815\uB2F5\uC774 \uC544\uB2C8\uC5D0\uC694. \uB298\uBD04 \uB3D9\uBB3C\uC6D0\uC744
    \uC88B\uC544\uD588\uB358 \uCE5C\uAD6C\uC758 \uC785\uC7A5\uC744 \uC0DD\uAC01\uD574
    \uBCF4\uC138\uC694. "
  - "\uB9DE\uC544\uC694. \uC774\uB807\uAC8C \uB9D0\uD558\uBA74 \uCE5C\uAD6C\uB9C8\uC74C\uB3C4
    \uC0C1\uD558\uC9C0 \uC54A\uACE0 \uB0B4\uAC00 \uC88B\uC544\uD588\uB358 \uACF3\uC5D0
    \uB300\uD574\uC11C\uB3C4 \uC18C\uAC1C\uD574 \uC904 \uC218 \uC788\uC5B4\uC694. "
  - "\uB9DE\uC544\uC694. \uBB34\uC5C7\uC774 \uB354 \uC88B\uC740\uC9C0 \uC774\uC57C\uAE30
    \uD558\uAE30 \uBCF4\uB2E4\uB294 \uD2B9\uC9D5\uB4E4\uC744 \uC774\uC57C\uAE30 \uD558\uBA74
    \uB9C8\uC74C \uC0C1\uD560 \uC77C\uB3C4 \uC5C6\uACE0 \uCE5C\uAD6C\uC5D0\uAC8C
    \uC88B\uC740 \uC815\uBCF4\uB97C \uC904 \uC218\uB3C4 \uC788\uC5B4\uC694. "
  - "\uB9DE\uC544\uC694. \uCE5C\uAD6C\uC5D0\uAC8C \uB180\uB9AC\uB294 \uAC83\uC744
    \uADF8\uB9CC\uD558\uB77C\uACE0 \uB2E8\uD638\uD558\uAC8C \uC774\uC57C\uAE30\uD558\uB294
    \uAC83\uC774 \uD544\uC694\uD574\uC694. \uB610\uD55C \uCE5C\uAD6C\uB85C \uC778\uD574
    \uBC1B\uC740 \uC0C1\uCC98\uC5D0 \uB300\uD574 \uC194\uC9C1\uD558\uAC8C \uB098\uB204\uB294
    \uAC83\uB3C4 \uC0DD\uAC01\uD574 \uBCF4\uC138\uC694"
  - "\uC774\uB7F0, \uC815\uB2F5\uC774 \uC544\uB2C8\uC5D0\uC694. \uB611\uAC19\uC774
    \uCE5C\uAD6C\uB97C \uB180\uB9AC\uB294 \uAC74 \uC88B\uC740 \uBC29\uBC95\uC774
    \uC544\uB2C8\uC5D0\uC694. \uB2E4\uC2DC \uC120\uD0DD\uD574\uBCF4\uC138\uC694."
  - "\uB9DE\uC544\uC694. \uCE5C\uAD6C\uB4E4\uC758 \uB9D0\uACFC \uC655\uB530\uC2DC\uD0A4\uB294
    \uD589\uB3D9 \uB54C\uBB38\uC5D0 \uB0B4\uAC00 \uC5B4\uB5A0\uD55C \uB9C8\uC74C\uC778\uC9C0
    \uD45C\uD604\uD558\uB294 \uAC83\uC774 \uD544\uC694\uD574\uC694."
  - "\uC774\uB7F0, \uC815\uB2F5\uC774 \uC544\uB2C8\uC5D0\uC694. \uB204\uB9AC\uC758
    \uC18C\uB9AC\uAC00 \uC791\uC544\uC11C \uC544\uC800\uC528\uAC00 \uB2F5\uD558\uC9C0
    \uBABB\uD558\uB294 \uAC8C \uC544\uB2C8\uB78D\uB2C8\uB2E4. \uB2E4\uC2DC \uC120\uD0DD\uD574\uBCF4\uC138\uC694."
  - "\uC774\uB7F0, \uC815\uB2F5\uC774 \uC544\uB2C8\uC5D0\uC694. \uC544\uC800\uC528\uAC00
    \uB204\uB9AC\uC758 \uB9D0\uC744 \uC77C\uBD80\uB7EC \uBB34\uC2DC\uD55C \uAC8C
    \uC544\uB2C8\uC5D0\uC694. \uB2E4\uC2DC \uC120\uD0DD\uD574\uBCF4\uC138\uC694."
  - "\uB9DE\uC544\uC694. \uC804\uD654\uD1B5\uD654 \uC911\uC778 \uC0AC\uC7A5\uB2D8\uC740
    \uB2F9\uC7A5 \uB204\uB9AC\uC5D0\uAC8C \uB2F5\uD574\uC904 \uC218 \uC5C6\uC744
    \uAC70\uC608\uC694. \uADF8\uB7F4 \uB550 \uC7A0\uC2DC \uAE30\uB2E4\uB824\uC57C
    \uD574\uC694."
  - "\uC774\uB7F0, \uC815\uB2F5\uC774 \uC544\uB2C8\uC5D0\uC694. \uADF8\uB300\uB85C
    \uC9D1\uC744 \uB098\uAC00\uB294 \uAC74 \uC88B\uC740 \uBC29\uBC95\uC774 \uC544\uB2C8\uC5D0\uC694.
    \uB2E4\uC2DC \uC120\uD0DD\uD574\uBCF4\uC138\uC694."
  - "\uB9DE\uC544\uC694. \uB54C\uB85C\uB294 \uC790\uC2E0\uC758 \uC798\uBABB\uC744
    \uC778\uC815\uD558\uACE0 \uC0AC\uACFC\uD558\uB294 \uAC83\uC774 \uD544\uC694\uD574\uC694. "
  - "\uC774\uB7F0, \uC815\uB2F5\uC774 \uC544\uB2C8\uC5D0\uC694. \uC9DC\uC99D\uB0B4\uACE0
    \uB204\uC6CC\uBC84\uB9AC\uB294 \uAC83\uC740 \uC88B\uC740 \uBC29\uBC95\uC774 \uC544\uB2C8\uC5D0\uC694.
    \uB2E4\uC2DC \uC120\uD0DD\uD574\uBCF4\uC138\uC694."
  - "\uC774\uB7F0, \uC815\uB2F5\uC774 \uC544\uB2C8\uC5D0\uC694. \uB2E4\uC2DC \uC120\uD0DD\uD574\uBCF4\uC138\uC694."
  - "\uB9DE\uC544\uC694. \uC0DD\uC77C\uC778 \uB2F9\uC0AC\uC790\uC5D0\uAC8C \uC9C1\uC811
    \uBB3C\uC5B4\uBCF4\uB294 \uAC74 \uC88B\uC740 \uBC29\uBC95\uC774\uC5D0\uC694."
  - "\uB9DE\uC544\uC694. \uB450 \uC0AC\uB78C \uBAA8\uB450 \uC790\uC2E0\uC774 \uC6D0\uD558\uB294
    \uAC83\uC744 \uC120\uD0DD\uD560 \uC218 \uC788\uB3C4\uB85D \uD0C0\uD611\uC548\uC744
    \uC81C\uC2DC\uD558\uB294 \uAC83\uB3C4 \uC88B\uC740 \uBC29\uBC95\uC774\uC5D0\uC694."
  - "\uB9DE\uC544\uC694. \uC774\uB807\uAC8C \uB9D0\uD558\uBA74 \uC870\uAE08 \uB354
    \uB180\uACE0\uC2F6\uC740 \uB9C8\uC74C\uC744 \uC5C4\uB9C8\uB3C4 \uC774\uD574\uD574
    \uC8FC\uC2E4\uAC70\uC608\uC694."
  - "\uC774\uB7F0, \uC815\uB2F5\uC774 \uC544\uB2C8\uC5D0\uC694. \uC18D\uC0C1\uD574\uB3C4
    \uC774\uB807\uAC8C \uD589\uB3D9\uD558\uB294 \uAC74 \uC88B\uC740 \uBC29\uBC95\uC774
    \uC544\uB2C8\uB78D\uB2C8\uB2E4. \uB2E4\uC2DC \uC120\uD0DD\uD574\uBCF4\uC138\uC694."
  - "\uB9DE\uC544\uC694. \uB2E4\uC74C\uBC88\uC744 \uC57D\uC18D\uD558\uBA70 \uC544\uC26C\uC6B4
    \uB9C8\uC74C\uC744 \uB2EC\uB7A0 \uC218 \uC788\uC744 \uAC70\uC608\uC694."
  - "\uB9DE\uC544\uC694. \uC774\uB807\uAC8C \uC18D\uC0C1\uD55C \uB9C8\uC74C\uC744
    \uD45C\uD604\uD558\uB294 \uAC83\uB3C4 \uAD1C\uCC2E\uC544\uC694. \uB610 \uC5F4\uC2EC\uD788
    \uD574\uC900 \uCE5C\uAD6C\uB4E4\uC744 \uC751\uC6D0\uD558\uB294 \uBAA8\uC2B5\uC774
    \uC815\uB9D0 \uBA4B\uC9C0\uB124\uC694."
  - "\uB9DE\uC544\uC694. \uAC8C\uC784\uC740 \uBAA8\uB450 \uD568\uAED8 \uC990\uAC81\uAE30
    \uC704\uD574 \uD558\uB294 \uAC70\uB78D\uB2C8\uB2E4. \uC774\uAE34 \uD300\uC5D0\uAC8C
    \uCD95\uD558\uD574 \uC8FC\uB294 \uAC83\uC740 \uC544\uC8FC \uBA4B\uC9C4 \uC77C\uC774\uC5D0\uC694. "
  - "\uC774\uB7F0, \uC815\uB2F5\uC774 \uC544\uB2C8\uC5D0\uC694. \uAC8C\uC784\uC740
    \uC9C8 \uB54C\uB3C4 \uC774\uAE38 \uB54C\uB3C4 \uC788\uB294 \uAC70\uB78D\uB2C8\uB2E4.
    \uB2E4\uC2DC \uC120\uD0DD\uD574\uBCF4\uC138\uC694."
  - "\uC774\uB7F0, \uC815\uB2F5\uC774 \uC544\uB2C8\uC5D0\uC694. \uB0B4\uAC00 \uC9C0\uAE08
    \uC774\uC57C\uAE30\uD558\uACE0 \uC2F6\uC740\uAC83\uC774 \uB2E4\uB974\uB354\uB77C\uB3C4
    \uCE5C\uAD6C\uC758 \uC9C8\uBB38\uC5D0 \uB2F5\uBCC0\uC744 \uD574\uC57C \uD55C\uB2F5\uB2C8\uB2E4.
    \uB2E4\uC2DC \uC120\uD0DD\uD574\uBCF4\uC138\uC694."
  - "\uB9DE\uC544\uC694. \uCE5C\uAD6C\uC640 \uD568\uAED8 \uB300\uD654\uD560 \uB54C
    \uAC19\uC740 \uC8FC\uC81C\uC5D0 \uB300\uD574 \uC774\uC57C\uAE30\uD558\uB294 \uAC83\uC774
    \uC88B\uC544\uC694."
  - "\uB9DE\uC544\uC694. \uCE5C\uAD6C \uBC18\uC751\uC744 \uBCF4\uACE0 \uB0B4\uAC00
    \uC801\uC808\uD55C \uB300\uB2F5\uC744 \uD588\uC5C8\uB294\uC9C0 \uC0DD\uAC01\uD574
    \uBCF4\uB294\uAC83\uB3C4 \uC88B\uC740 \uBC29\uBC95\uC774\uC5D0\uC694."
  - "\uC774\uB7F0, \uC815\uB2F5\uC774 \uC544\uB2C8\uC5D0\uC694. \uB2E4\uB978 \uC0AC\uB78C\uC744
    \uD0D3\uD558\uAE30 \uC804\uC5D0 \uB0B4 \uC790\uC2E0\uC758 \uC798\uBABB\uC744
    \uBA3C\uC800 \uB3CC\uC544\uBD10\uC57C \uD569\uB2C8\uB2E4. \uB2E4\uC2DC \uC120\uD0DD\uD574\uBCF4\uC138\uC694."
  - "\uB9DE\uC544\uC694. \uC0AC\uACFC\uB97C \uD558\uACE0 \uC0C1\uB300\uBC29\uC774
    \uAD1C\uCC2E\uC740\uC9C0 \uBB3C\uC5B4\uBCF4\uB294 \uAC83\uC774 \uAC00\uC7A5 \uBC14\uB78C\uC9C1\uD574\uC694."
  - "\uC774\uB7F0, \uC815\uB2F5\uC774 \uC544\uB2C8\uC5D0\uC694. \uB0B4\uAC00 \uC8FC\uC758\uB97C
    \uAE30\uC6B8\uC774\uC9C0 \uC54A\uC544 \uC77C\uC5B4\uB09C \uC77C\uC774\uB2C8 \uBD80\uB52A\uD788\uC9C0
    \uC54A\uC558\uC5B4\uB3C4 \uC0AC\uACFC\uB97C \uD574\uC57C \uD574\uC694. \uB2E4\uC2DC
    \uC120\uD0DD\uD574\uBCF4\uC138\uC694."
  - "\uC774\uB7F0, \uC815\uB2F5\uC774 \uC544\uB2C8\uC5D0\uC694. \uCE5C\uAD6C\uC640
    \uB611\uAC19\uC774 \uC798\uBABB\uB41C \uD589\uB3D9\uC744 \uD558\uB294 \uAC74
    \uC88B\uC740 \uBC29\uBC95\uC774 \uC544\uB2C8\uC5D0\uC694. \uB2E4\uC2DC \uC120\uD0DD\uD574\uBCF4\uC138\uC694."
  - "\uB9DE\uC544\uC694. \uB2E8\uD638\uD558\uAC8C \uD558\uC9C0 \uB9D0\uB77C\uACE0
    \uAC15\uD558\uAC8C \uB9D0 \uD560 \uC218 \uC788\uC5B4\uC57C \uD569\uB2C8\uB2E4. "
  - "\uB9DE\uC544\uC694. \uCE5C\uAD6C\uB4E4\uC758 \uC798\uBABB\uB41C \uD589\uB3D9\uC774
    \uACC4\uC18D\uB41C\uB2E4\uBA74 \uC8FC\uBCC0\uC758 \uB3C4\uC6C0\uC744 \uBC1B\uB294
    \uAC83\uB3C4 \uC88B\uC740 \uD574\uACB0 \uBC29\uBC95\uC785\uB2C8\uB2E4."
  - "\uC774\uB7F0, \uC815\uB2F5\uC774 \uC544\uB2C8\uC5D0\uC694. \uC870\uAE08 \uC2E4\uC218\uD588\uB2E4\uACE0
    \uB9E4\uBC88 \uD3EC\uAE30\uD55C\uB2E4\uBA74 \uBB34\uC5C7\uC744 \uD560 \uC218
    \uC788\uC744\uAE4C\uC694? \uB2E4\uC2DC \uC120\uD0DD\uD574\uBCF4\uC138\uC694."
  - "\uB9DE\uC544\uC694. \uC2AC\uD508 \uB9C8\uC74C\uC744 \uD63C\uC790 \uAC00\uC9C0\uACE0
    \uC788\uB294 \uAC83\uBCF4\uB2E4 \uCE5C\uAD6C\uC5D0\uAC8C \uC774\uC57C\uAE30\uD558\uBA74
    \uB098\uC544\uC9C8 \uC218 \uC788\uC5B4\uC694. "
  - "\uC88B\uC740 \uC0DD\uAC01\uC774\uC5D0\uC694. \uBE44\uB85D \uC2E4\uC218\uB294
    \uD588\uC9C0\uB9CC \uB9C9\uC0C1 \uC0DD\uAC01\uD574 \uBCF4\uBA74 \uC798 \uD55C
    \uBD80\uBD84\uB3C4 \uB9CE\uAE30\uC5D0 \uC798\uD588\uB358 \uBD80\uBD84\uC744 \uB5A0\uC62C\uB824
    \uBCF4\uB294 \uAC83\uC740 \uC88B\uC740 \uBC29\uBC95\uC774\uC5D0\uC694. "
  - "\uC774\uB7F0, \uC815\uB2F5\uC774 \uC544\uB2C8\uC5D0\uC694. \uAC00\uB78C\uC774\uC758
    \uB3C4\uC6C0\uC744 \uBC1B\uC9C0 \uBABB\uD55C \uAC74 \uC544\uC27D\uC9C0\uB9CC
    \uC77C\uBD80\uB7EC \uB3D5\uC9C0 \uC54A\uC740 \uAC8C \uC544\uB2C8\uB2C8 \uAC00\uB78C\uC774\uC758
    \uC0C1\uD669\uB3C4 \uC774\uD574\uD560 \uC904 \uC218 \uC788\uC544\uC57C \uD574\uC694.
    \uB2E4\uC2DC \uC120\uD0DD\uD574\uBCF4\uC138\uC694."
  - "\uB9DE\uC544\uC694. \uAC00\uB78C\uC774\uAC00 \uC77C\uBD80\uB7EC \uB3C4\uC640\uC8FC\uC9C0
    \uC54A\uB294 \uAC8C \uC544\uB2C8\uB2C8 \uAD1C\uCC2E\uB2E4\uACE0 \uC774\uC57C\uAE30\uD558\uACE0
    \uB2E4\uB978 \uBC29\uBC95\uC744 \uCC3E\uC544\uBCF4\uB294\uAC8C \uC88B\uACA0\uC5B4\uC694."
  - "\uB9DE\uC544\uC694. \uB0B4\uAC00 \uC2A4\uC2A4\uB85C \uD560 \uC218 \uC788\uB294
    \uBD80\uBD84\uACFC \uBD80\uD0C1\uD560 \uBD80\uBD84\uC744 \uC870\uC815\uD574 \uBCF4\uB294\uAC83\uC774
    \uC815\uB9D0 \uBA4B\uC9C4 \uD574\uACB0\uBC29\uBC95\uC774\uB124\uC694."
  - "\uC774\uB7F0, \uC815\uB2F5\uC774 \uC544\uB2C8\uC5D0\uC694. \uB3C4\uC6C0\uC744
    \uC900 \uBD84\uC758 \uC785\uC7A5\uC744 \uC0DD\uAC01\uD574 \uBCF4\uBA70 \uB2E4\uC2DC
    \uC120\uD0DD\uD574\uBCF4\uC138\uC694."
  - "\uB9DE\uC544\uC694. \uBAA8\uB974\uB294 \uBD84\uC5D0\uAC8C\uB77C\uB3C4 \uB3C4\uC6C0\uC744
    \uBC1B\uC558\uB2E4\uBA74 '\uAC10\uC0AC\uD569\uB2C8\uB2E4'\uB77C\uACE0 \uB9D0\uD558\uAC70\uB098
    \uACE0\uAC1C\uC778\uC0AC\uB85C \uACE0\uB9C8\uC6C0\uC744 \uD45C\uD604\uD558\uB294\uAC8C
    \uC88B\uACA0\uC8E0?"
  - "\uC774\uB7F0, \uC815\uB2F5\uC774 \uC544\uB2C8\uC5D0\uC694. \uB3C4\uC6C0\uC744
    \uC900 \uBD84\uC758 \uC785\uC7A5\uC744 \uC0DD\uAC01\uD574 \uBCF4\uBA70 \uB2E4\uC2DC
    \uC120\uD0DD\uD574\uBCF4\uC138\uC694."
  - "\uC774\uB7F0, \uC815\uB2F5\uC774 \uC544\uB2C8\uC5D0\uC694. \uB2E4\uB978 \uC0AC\uB78C\uB4E4\uC774
    \uB098\uC640 \uC758\uACAC\uC774 \uB2E4\uB974\uB2E4\uACE0 \uD574\uC11C \uC544\uC608
    \uCC38\uC5EC\uD558\uC9C0 \uC54A\uB294 \uAC74 \uC88B\uC740 \uBC29\uBC95\uC774
    \uC544\uB2C8\uC5D0\uC694. \uB2E4\uC2DC \uC120\uD0DD\uD574\uBCF4\uC138\uC694."
  - "\uB9DE\uC544\uC694. \uCE5C\uAD6C\uB4E4\uC740 \uB098\uC640 \uC758\uACAC\uC774
    \uB2E4\uB97C \uC218 \uC788\uB2E4\uB294 \uAC78 \uC778\uC815\uD558\uACE0 \uB2E4\uB978
    \uC758\uACAC\uC744 \uBB3C\uC5B4\uBCF4\uB294 \uAC83\uB3C4 \uC88B\uC740 \uBC29\uBC95\uC774\uC5D0\uC694."
  - "\uB9DE\uC544\uC694. \uC758\uACAC\uC744 \uC870\uC815\uD560 \uB54C \uC870\uAE08
    \uB354 \uC790\uC138\uD558\uAC8C \uC790\uC2E0\uC758 \uC758\uACAC\uC744 \uC124\uBA85\uD558\uB294
    \uAC83\uB3C4 \uC88B\uC740 \uBC29\uBC95\uC774\uC5D0\uC694."
  - "\uC774\uB7F0, \uC815\uB2F5\uC774 \uC544\uB2C8\uC5D0\uC694. \uBBF8\uC548\uD558\uB2E4\uB294
    \uB9C8\uC74C\uC774 \uC804\uD574\uC9C0\uB3C4\uB85D \uC9C4\uC9C0\uD558\uAC8C \uC0AC\uACFC\uB97C
    \uD574\uC57C\uD574\uC694. \uB2E4\uC2DC \uC120\uD0DD\uD574\uBCF4\uC138\uC694."
  - "\uC774\uB7F0, \uC815\uB2F5\uC774 \uC544\uB2C8\uC5D0\uC694. \uCE5C\uAD6C \uB07C\uB9AC
    \uD55C \uC57D\uC18D\uC740 \uC9C0\uD0A4\uB824\uACE0 \uB178\uB825\uD574\uC57C\uC9C0\uC694.
    \uB2E4\uC2DC \uC120\uD0DD\uD574\uBCF4\uC138\uC694."
  - "\uB9DE\uC544\uC694. \uC790\uC2E0\uC758 \uC798\uBABB\uC744 \uC194\uC9C1\uD558\uAC8C
    \uC778\uC815\uD558\uACE0 \uC9C4\uC2EC\uC73C\uB85C \uC0AC\uACFC\uD558\uB294 \uAC83\uC774
    \uAC00\uC7A5 \uC88B\uC740 \uBC29\uBC95\uC774\uC5D0\uC694."
  - "\uC774\uB7F0, \uC815\uB2F5\uC774 \uC544\uB2C8\uC5D0\uC694. \uB2E4\uC2DC \uC120\uD0DD\uD574
    \uBCF4\uC138\uC694."
  - "\uD070\uC18C\uB9AC\uB85C \uC598\uAE30\uD55C\uB2E4\uACE0 \uD574\uC11C \uB098\uB3C4
    \uC9DC\uC99D\uB0B4\uAC70\uB098 \uD070 \uC18C\uB9AC\uB85C \uC9C0\uC801\uD558\uB294
    \uAC83\uC740 \uC801\uC808\uD558\uC9C0 \uC54A\uC544\uC694. \uB2E4\uC2DC \uC120\uD0DD\uD574\uBCF4\uC138\uC694. "
  - "\uB9DE\uC544\uC694, \uB9CE\uC740 \uC0AC\uB78C\uB4E4\uC774 \uC788\uB294 \uACF5\uAC04\uC5D0\uC11C\uB294
    \uC870\uC6A9\uD788 \uB300\uD654\uB97C \uB098\uB220\uC57C \uD55C\uB2E4\uACE0 \uC791\uC740
    \uC18C\uB9AC\uB85C \uB9D0\uD574 \uC8FC\uB294\uAC83\uC774 \uC88B\uACA0\uC9C0\uC694?"
  - "\uC774\uB7F0, \uC815\uB2F5\uC774 \uC544\uB2C8\uC5D0\uC694. \uC5B4\uB978\uC744
    \uCC98\uC74C \uB9CC\uB0AC\uC744 \uB54C\uC5D0\uB294 \uC5B4\uB5BB\uAC8C \uD558\uB294\uAC83\uC774
    \uC88B\uC744\uAE4C\uC694? \uB2E4\uC2DC \uC120\uD0DD\uD574\uBCF4\uC138\uC694."
  - "\uC774\uB7F0, \uC815\uB2F5\uC774 \uC544\uB2C8\uC5D0\uC694. \uCE5C\uD55C\uCE5C\uAD6C
    \uC5B4\uBA38\uB2C8\uB77C\uACE0 \uD574\uB3C4 \uB9CC\uB098\uC790 \uB9C8\uC790 \uAC04\uC2DD\uC744
    \uB2EC\uB77C\uACE0 \uBD80\uD0C1\uD558\uB294 \uAC83\uC740 \uC608\uC758\uAC00 \uC544\uB2C8\uB78D\uB2C8\uB2E4.
    \uB2E4\uC2DC \uC120\uD0DD\uD574\uBCF4\uC138\uC694."
  - "\uB9DE\uC544\uC694. \uC0C8\uB85C\uC6B4 \uACF3\uC5D0 \uAC14\uC744 \uB54C\uB294
    \uBA3C\uC800 \uC778\uC0AC\uB97C \uD558\uACE0 \uC790\uC2E0\uC744 \uC18C\uAC1C\uD558\uB294
    \uAC83\uC774 \uC608\uC758\uB78D\uB2C8\uB2E4. "
