# CAFE24 VPS (실제 값은 .env.cafe24에 저장 — git 커밋 금지)
CAFE24_VPS_HOST=your.vps.ip
CAFE24_VPS_DOMAIN=hudit.cafe24.com
CAFE24_VPS_USER=root
CAFE24_VPS_PASSWORD=your-password
CAFE24_VPS_PORT=22
CAFE24_VPS_HOSTKEY=your-hostkey-sha256

# MTalk 공개 접속 주소 (Unity / API 검증)
MTALK_PUBLIC_BASE_URL=http://hudit.cafe24.com:8080
MTALK_MBENCH_BASE_URL=http://hudit.cafe24.com:8080/mbench
MTALK_MBODY_BASE_URL=http://hudit.cafe24.com:8080/mbody
MTALK_MFACE_BASE_URL=http://hudit.cafe24.com:8080/mface
MTALK_MSOCIAL_BASE_URL=http://hudit.cafe24.com:8080/msocial

# VPS Docker DB (컨테이너 내부)
MTALK_DB_USER=mtalk
MTALK_DB_PASSWORD=your-db-password
MBENCH_ADMIN_PASSWORD=your-admin-password

# CNT (cnt.re.kr MySQL — read-only 조회)
CNT_DB_HOST=db.cnt.re.kr
CNT_DB_PORT=3306
CNT_DB_NAME=dbhuditcnt
CNT_DB_USER=huditcnt
CNT_DB_PASSWORD=your-cnt-db-password
CNT_LEGACY_BASE_URL=http://cnt.re.kr

# CNT Cafe24 API/PDF -> huditcnt.cafe24.com
CNT_HUDIT_BASE_URL=http://huditcnt.cafe24.com
CNT_HUDIT_INTERNAL_BASE_URL=http://huditcnt.cafe24.com
CNT_HUDIT_PDF_TEMPLATE_SUFFIX=pdf
CNT_HUDIT_DB_HOST=huditcnt.cafe24.com
CNT_HUDIT_DB_PORT=3306
CNT_HUDIT_DB_NAME=dbhuditcnt
CNT_HUDIT_DB_USER=huditcnt
CNT_HUDIT_DB_PASSWORD=your-huditcnt-db-password
CNTHUDIT_PUBLIC_BASE_URL=https://huditcnt.cafe24.com
CNTHUDIT_ENTRY_TICKET_SECRET=your-entry-ticket-secret

# huditcnt VPS jump host (실제 값은 .env.huditcnt-vps에 저장)
CAFE24_JUMP_HOST=your.jump.host.ip
CAFE24_JUMP_USER=root
CAFE24_JUMP_PASSWORD=your-jump-password
CAFE24_JUMP_PORT=22

# Gabia cnt.re.kr (실제 값은 .env.gabia-cnt에 저장)
GABIA_CNT_WEB_URL=http://cnt.re.kr
GABIA_CNT_WEB_HOST=your.cnt.host.ip
GABIA_CNT_WEB_LOGIN_ID=your-login-id
GABIA_CNT_WEB_PASSWORD=your-password
GABIA_CNT_SSH_HOST=your.cnt.host.ip
GABIA_CNT_SSH_PORT=22
GABIA_CNT_SSH_USER=your-ssh-user
GABIA_CNT_SSH_PASSWORD=your-ssh-password
GABIA_CNT_SSH_HOSTKEY=your-hostkey-sha256
GABIA_CNT_DB_HOST=your.db.host
GABIA_CNT_DB_PORT=3306
GABIA_CNT_DB_NAME=your-db-name
GABIA_CNT_DB_USER=your-db-user
GABIA_CNT_DB_PASSWORD=your-db-password
GABIA_CNT_DB_URL=jdbc:mysql://your.db.host:3306/your-db-name?characterEncoding=utf8
